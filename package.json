    "prisma:generate": "prisma generate",
    "seed:vendor-demo": "ts-node scripts/seed-vendor-demo.ts",
    "seed:advertisements": "ts-node --transpile-only scripts/seed-advertisements.ts",
    "test:payment-wallet-seed": "node --test tests/seed-payment-wallet-demo.test.js",
    "worker:booking-settlements": "ts-node --transpile-only src/modules/booking/booking-settlement.worker.ts",
    "worker:whatsapp": "ts-node --transpile-only src/modules/whatsapp/workers/worker.ts",
    "seed:dashboard-demo": "ts-node scripts/seed-dashboard-demo.ts",
    "verify:dashboard-demo": "ts-node scripts/verify-dashboard-demo.ts",
    "seed:payment-wallet-demo": "ts-node --files scripts/seed-payment-wallet-demo.ts",
    "reset:payment-wallet-demo": "ts-node --files scripts/reset-payment-wallet-demo.ts",
    "seed:customer-inventory": "ts-node scripts/seed-customer-inventory.ts",
    "seed:tracking-demo": "ts-node --transpile-only scripts/seed-tracking-demo.ts",
    "repair:vendor-permissions": "ts-node scripts/repair-vendor-permissions.ts",
    "backfill:vendor-onboarding": "ts-node scripts/backfill-vendor-onboarding.ts",
    "seed:staff": "ts-node scripts/seed-staff-demo.ts",
    "seed:staff:reset": "ts-node scripts/reset-staff-demo.ts",
    "start": "node dist/index.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
