model User {
  id                String       @id @default(uuid())
  firstName         String
  lastName          String?
  email             String       @unique
  phone             String
  countryCode       String
  password          String
  isActive          Boolean      @default(true)
  gender            Gender?
  dob               DateTime?
  preferredLanguage LanguageCode @default(en)

  roles             UserRole[]
  directPermissions UserPermission[]

  ownedSalons       Salon[]           @relation("SalonOwner")
  staffIn           SalonStaff[]
  createdExpenses   Expense[]         @relation("ExpenseCreatedBy")
  updatedExpenses   Expense[]         @relation("ExpenseUpdatedBy")
  expenseCategories ExpenseCategory[] @relation("ExpenseCategoryVendor")

  staffCreated SalonStaff[] @relation("StaffCreatedBy")
  staffUpdated SalonStaff[] @relation("StaffUpdatedBy")

  serviceCreated Service[] @relation("ServiceCreatedBy")
  serviceUpdated Service[] @relation("ServiceUpdatedBy")

  salonCustomers                   SalonCustomer[]
  favoriteSalons                   CustomerFavoriteSalon[]
  couponsOwned                     Coupon[]                      @relation("CouponOwner")
  couponRedemptions                CouponRedemption[]
  couponAssignments                CouponVendor[]
  reviews                          Review[]
  wallet                           CustomerWallet?
  walletTransactions               WalletTransaction[]
  vendorWallet                     VendorWallet?
  vendorPayoutAccount              VendorPayoutAccount?
  bookingCommissionRulesCreated    BookingCommissionRule[]       @relation("BookingCommissionRuleCreator")
  bookingFinanceAsVendor           BookingFinancialTransaction[] @relation("BookingFinanceVendor")
  bookingFinanceAsCustomer         BookingFinancialTransaction[] @relation("BookingFinanceCustomer")
  bookingFinanceApprovals          BookingFinancialTransaction[] @relation("BookingFinanceApprover")
  bookingFinanceRejections         BookingFinancialTransaction[] @relation("BookingFinanceRejector")
  vendorSettlements                VendorSettlement[]            @relation("VendorSettlementVendor")
  vendorSettlementsCreated         VendorSettlement[]            @relation("VendorSettlementCreator")
  bookingFinanceAudits             BookingFinanceAuditLog[]
  vendorWalletLedgerEntries        VendorWalletLedger[]          @relation("VendorWalletLedgerActor")
  bookingSettlementSettingsUpdated BookingSettlementSettings[]
  referralsSent                    CustomerReferral[]            @relation("ReferralSender")
  referralsReceived                CustomerReferral[]            @relation("ReferralReceiver")
  customerAddresses                CustomerAddress[]
  advertisementsCreated            Advertisement[]               @relation("AdvertisementCreator")
  advertisementsUpdated            Advertisement[]               @relation("AdvertisementUpdater")

  source    UserSource @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  version   Int        @default(1)

  markedAttendances              Attendance[]
  passwordResetTokens            PasswordResetToken[]
  customerOtpChallenges          CustomerOtpChallenge[]
  customerBookings               Booking[]                       @relation("CustomerBookings")
  inventoryProducts              VendorProduct[]
  productCategories              ProductCategory[]               @relation("ProductCategoryVendor")
  productBrands                  ProductBrand[]                  @relation("ProductBrandVendor")
  createdCategories              ProductCategory[]               @relation("ProductCategoryCreatedBy")
  feedPosts                      FeedPost[]                      @relation("FeedPostVendor")
  feedStories                    FeedStory[]                     @relation("FeedStoryVendor")
  feedPostLikes                  FeedPostLike[]                  @relation("FeedPostLikeUser")
  feedComments                   FeedComment[]                   @relation("FeedCommentUser")
  feedPostViews                  FeedPostView[]                  @relation("FeedPostViewUser")
  feedStoryViews                 FeedStoryView[]                 @relation("FeedStoryViewUser")
  feedShares                     FeedShare[]                     @relation("FeedShareUser")
  feedReports                    FeedReport[]                    @relation("FeedReportUser")
  resolvedReports                FeedReport[]                    @relation("FeedReportResolvedBy")
  whatsappConfigurations         WhatsAppConfiguration[]         @relation("WhatsAppConfigCreatedBy")
  whatsappTemplatesCreated       WhatsAppTemplate[]              @relation("WhatsAppTemplateCreatedBy")
  whatsappCampaignsCreated       WhatsAppCampaign[]              @relation("WhatsAppCampaignCreatedBy")
  whatsappContacts               WhatsAppContact[]               @relation("WhatsAppContactCustomer")
  whatsappAuditLogs              WhatsAppAuditLog[]
  subscriptions                  Subscription[]                  @relation("SubscriptionVendor")
  subscriptionPayments           SubscriptionPayment[]           @relation("SubscriptionPaymentVendor")
  subscriptionAuditLogs          SubscriptionAuditLog[]          @relation("SubscriptionAuditActor")
  subscriptionInvoices           SubscriptionInvoice[]           @relation("SubscriptionInvoiceVendor")
  subscriptionVendorAuditLogs    SubscriptionAuditLog[]          @relation("SubscriptionAuditVendor")
  createdSubscriptionFeatures    SubscriptionFeature[]           @relation("SubscriptionFeatureCreator")
  feedAdminAudits                FeedAdminAudit[]
  razorpayConfigurations         RazorpayConfiguration[]         @relation("RazorpayConfigCreator")
  ownedRazorpayConfigurations    RazorpayConfiguration[]         @relation("RazorpayConfigOwner")
  smtpConfigurations             SmtpConfiguration[]             @relation("SmtpConfigCreatedBy")
  smtpConfigurationsUpdated      SmtpConfiguration[]             @relation("SmtpConfigUpdatedBy")
  platformWhatsAppConfigs        PlatformWhatsAppConfiguration[] @relation("PlatformWhatsAppConfigCreatedBy")
  platformWhatsAppConfigsUpdated PlatformWhatsAppConfiguration[] @relation("PlatformWhatsAppConfigUpdatedBy")
  ownedSmtpConfigurations        SmtpConfiguration[]             @relation("SmtpConfigVendor")
  ownedPlatformWhatsAppConfigs   PlatformWhatsAppConfiguration[] @relation("PlatformWhatsAppConfigVendor")
  whatsappCampaignBillings       WhatsAppCampaignBilling[]       @relation("WhatsAppBillingVendor")
  trackingSessions               UserTrackingSession[]
  trackingActivities             UserTrackingActivity[]
}

model UserTrackingSession {
  id                    String                 @id @default(uuid())
  userId                String
  actorType             TrackingActorType
  vendorId              String?
  staffId               String?
  customerId            String?
  salonId               String?
  branchId              String?
  roleId                String?
  sessionId             String                 @unique
  loginAt               DateTime               @default(now())
  logoutAt              DateTime?
  lastActivityAt        DateTime               @default(now())
  lastHeartbeatAt       DateTime?
  totalDurationSeconds  Int                    @default(0)
  activeDurationSeconds Int                    @default(0)
  status                TrackingSessionStatus  @default(ACTIVE)
  ipAddress             String?
  country               String?
  countryCode           String?
  state                 String?
  city                  String?
  latitude              Float?
  longitude             Float?
  timezone              String?
  locationProvider      String?
  locationSource        TrackingLocationSource @default(UNKNOWN)
  deviceType            String?
  deviceName            String?
  operatingSystem       String?
  browser               String?
  appVersion            String?
  userAgent             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([vendorId, createdAt])
  @@index([staffId, createdAt])
  @@index([customerId, createdAt])
  @@index([salonId, createdAt])
  @@index([branchId, createdAt])
  @@index([roleId, createdAt])
  @@index([actorType, createdAt])
  @@index([loginAt])
  @@index([lastActivityAt, status])
  @@index([ipAddress])
}

model UserTrackingActivity {
  id               String            @id @default(uuid())
  userId           String
  actorType        TrackingActorType
  vendorId         String?
  staffId          String?
  customerId       String?
  salonId          String?
  branchId         String?
  roleId           String?
  sessionId        String?
  menuId           String?
  parentMenuId     String?
  menuNameSnapshot String?
  moduleName       String?
  eventType        String
  action           String?
  route            String?
  screenName       String?
  method           String?
  entityType       String?
  entityId         String?
  status           String?
  durationMs       Int?
  metadata         Json?
  ipAddress        String?
  country          String?
  state            String?
  city             String?
  createdAt        DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([vendorId, createdAt])
  @@index([staffId, createdAt])
  @@index([customerId, createdAt])
  @@index([salonId, createdAt])
  @@index([branchId, createdAt])
  @@index([roleId, createdAt])
  @@index([sessionId, createdAt])
  @@index([menuId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorType, createdAt])
  @@index([createdAt])
  @@index([ipAddress])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CustomerOtpChallenge {
  id         String    @id @default(uuid())
  userId     String?
  email      String?
  phone      String?
  channel    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, channel, createdAt])
  @@index([phone, channel, createdAt])
}

// Platform-wide delivery configuration. Credentials are AES-GCM encrypted by
// the application and are deliberately never selected by public API handlers.
model SmtpConfiguration {
  id                String    @id @default(uuid())
  provider          String    @default("SMTP")
  vendorId          String?
  salonId           String?
  host              String
  port              Int
  username          String
  encryptedPassword String
  secure            Boolean   @default(false)
  requireTLS        Boolean   @default(false)
  fromEmail         String
  fromName          String
  replyTo           String?
  connectionTimeout Int       @default(10000)
  enabled           Boolean   @default(false)
  encryption        String    @default("tls")
  isVerified        Boolean   @default(false)
  lastTestedAt      DateTime?
  lastTestStatus    String?
  createdBy         String
  updatedBy         String?
  creator           User      @relation("SmtpConfigCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater           User?     @relation("SmtpConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  vendor            User?     @relation("SmtpConfigVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId, salonId, enabled])
  @@index([salonId])
}

model PlatformWhatsAppConfiguration {
  id                          String    @id @default(uuid())
  provider                    String    @default("META_WHATSAPP_CLOUD_API")
  vendorId                    String?
  salonId                     String?
  encryptedAccessToken        String
  phoneNumberId               String
  businessAccountId           String
  apiVersion                  String    @default("v20.0")
  metaAppId                   String?
  encryptedWebhookVerifyToken String?
  webhookUrl                  String?
  otpTemplateName             String    @default("authentication")
  templateLanguage            String    @default("en_US")
  enabled                     Boolean   @default(false)
  isVerified                  Boolean   @default(false)
  lastTestedAt                DateTime?
  lastTestStatus              String?
  createdBy                   String
  updatedBy                   String?
  creator                     User      @relation("PlatformWhatsAppConfigCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater                     User?     @relation("PlatformWhatsAppConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  vendor                      User?     @relation("PlatformWhatsAppConfigVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([vendorId, salonId, enabled])
  @@index([phoneNumberId])
}

model Role {
  id                 String  @id @default(uuid())
  name               String  @unique
  subscriptionPlanId String?
  isActive           Boolean @default(true)

  subscriptionPlan            SubscriptionPlan?                @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  users                       UserRole[]
  permissions                 RolePermission[]
  subscriptionPlanPermissions SubscriptionPlanRolePermission[]

  @@index([subscriptionPlanId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Salon {
  id       String  @id @default(uuid())
  parentId String?
  parent   Salon?  @relation("SalonBranches", fields: [parentId], references: [id])
  branches Salon[] @relation("SalonBranches")

  name      String
  ownerId   String
  salonType String?

  description String?
  avgPrice    Float?
  avgWaitTime Int?

  timings  Json
  isActive Boolean @default(true)
  isMain   Boolean @default(false)

  owner                           User                          @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff                           SalonStaff[]
  address                         Address?
  images                          SalonImage[]
  contacts                        SalonContact[]
  services                        Service[]
  coupons                         Coupon[]
  couponAssignments               CouponSalon[]
  branchCouponAssignments         CouponBranch[]
  reviews                         Review[]
  advertisements                  Advertisement[]
  combos                          Combo[]
  customers                       SalonCustomer[]
  favoriteCustomers               CustomerFavoriteSalon[]
  staffRoles                      StaffRole[]
  bookings                        Booking[]
  bookingFinanceTransactions      BookingFinancialTransaction[] @relation("BookingFinanceSalon")
  bookingFinanceBranches          BookingFinancialTransaction[] @relation("BookingFinanceBranch")
  branchBookings                  Booking[]                     @relation("BookingBranch")
  couponBranches                  Coupon[]                      @relation("CouponBranch")
  reviewBranches                  Review[]                      @relation("ReviewBranch")
  advertisementBranches           Advertisement[]               @relation("AdvertisementBranch")
  gstConfig                       GSTConfiguration?
  vendorProductListings           VendorProduct[]               @relation("VendorProductSalon")
  branchProductListings           VendorProduct[]               @relation("VendorProductBranch")
  inventoryStocks                 InventoryStock[]              @relation("InventoryStockSalon")
  branchInventoryStocks           InventoryStock[]              @relation("InventoryStockBranch")
  productCategories               ProductCategory[]             @relation("ProductCategorySalon")
  branchProductCategories         ProductCategory[]             @relation("ProductCategoryBranch")
  productBrands                   ProductBrand[]                @relation("ProductBrandSalon")
  feedPosts                       FeedPost[]                    @relation("FeedPostSalon")
  feedPostBranches                FeedPost[]                    @relation("FeedPostBranch")
  feedStories                     FeedStory[]                   @relation("FeedStorySalon")
  feedStoryBranches               FeedStory[]                   @relation("FeedStoryBranch")
  whatsappConnections             WhatsAppConnection[]          @relation("WhatsAppConnectionSalon")
  whatsappConnectionBranches      WhatsAppConnection[]          @relation("WhatsAppConnectionBranch")
  whatsappContacts                WhatsAppContact[]             @relation("WhatsAppContactSalon")
  whatsappContactBranches         WhatsAppContact[]             @relation("WhatsAppContactBranch")
  whatsappTemplates               WhatsAppTemplate[]            @relation("WhatsAppTemplateSalon")
  whatsappTemplateBranches        WhatsAppTemplate[]            @relation("WhatsAppTemplateBranch")
  whatsappCampaigns               WhatsAppCampaign[]            @relation("WhatsAppCampaignSalon")
  whatsappCampaignBranches        WhatsAppCampaign[]            @relation("WhatsAppCampaignBranch")
  whatsappMessages                WhatsAppMessage[]             @relation("WhatsAppMessageSalon")
  whatsappMessageBranches         WhatsAppMessage[]             @relation("WhatsAppMessageBranch")
  whatsappUsage                   WhatsAppUsageLedger[]         @relation("WhatsAppUsageSalon")
  whatsappUsageBranches           WhatsAppUsageLedger[]         @relation("WhatsAppUsageBranch")
  whatsappCampaignBillings        WhatsAppCampaignBilling[]     @relation("WhatsAppBillingSalon")
  whatsappCampaignBillingBranches WhatsAppCampaignBilling[]     @relation("WhatsAppBillingBranch")
  subscriptions                   Subscription[]                @relation("SubscriptionSalon")
  expenses                        Expense[]                     @relation("ExpenseSalon")
  branchExpenses                  Expense[]                     @relation("ExpenseBranch")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int      @default(1)
  isProfileCompleted Boolean  @default(false)
}

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  categoryId       String?
  brandId          String?
  productType      ProductType   @default(RETAIL)
  status           ProductStatus @default(DRAFT)
  gstRate          Float         @default(0)
  hsnCode          String?

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  brand    ProductBrand?    @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  listings VendorProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id           String        @id @default(uuid())
  productId    String
  name         String
  sku          String        @unique
  barcode      String?
  variantCode  String?
  costPrice    Float         @default(0)
  mrp          Float         @default(0)
  sellingPrice Float         @default(0)
  weight       Float?
  weightUnit   String?
  volume       Float?
  volumeUnit   String?
  status       ProductStatus @default(ACTIVE)

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]
  stocks  InventoryStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barcode])
}

model ProductCategory {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  parentId    String?
  vendorId    String?
  salonId     String?
  branchId    String?
  createdById String?
  status      InventoryEntityStatus @default(ACTIVE)

  parent    ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryTree")
  products  Product[]
  vendor    User?             @relation("ProductCategoryVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  salon     Salon?            @relation("ProductCategorySalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch    Salon?            @relation("ProductCategoryBranch", fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("ProductCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([vendorId])
  @@index([salonId])
  @@index([branchId])
}

model ProductBrand {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  vendorId    String?
  salonId     String?
  status      InventoryEntityStatus @default(ACTIVE)

  products Product[]
  vendor   User?     @relation("ProductBrandVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  salon    Salon?    @relation("ProductBrandSalon", fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([vendorId])
  @@index([salonId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model VendorProduct {
  id            String        @id @default(uuid())
  vendorId      String
  productId     String
  salonId       String
  branchId      String?
  vendorPrice   Float         @default(0)
  sellingPrice  Float         @default(0)
  discount      Float         @default(0)
  isListed      Boolean       @default(false)
  listingStatus ListingStatus @default(PENDING)
  availableFrom DateTime?
  availableTo   DateTime?

  vendor  User             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  salon   Salon            @relation("VendorProductSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch  Salon?           @relation("VendorProductBranch", fields: [branchId], references: [id], onDelete: Cascade)
  stocks  InventoryStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, productId, salonId, branchId])
  @@index([vendorId])
  @@index([productId])
  @@index([salonId])
  @@index([branchId])
  @@index([listingStatus])
}

model InventoryStock {
  id               String  @id @default(uuid())
  vendorProductId  String
  variantId        String
  salonId          String
  branchId         String?
  quantity         Int     @default(0)
  reservedQuantity Int     @default(0)
  reorderLevel     Int     @default(0)

  vendorProduct VendorProduct          @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)
  variant       ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  salon         Salon                  @relation("InventoryStockSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch        Salon?                 @relation("InventoryStockBranch", fields: [branchId], references: [id], onDelete: Cascade)
  transactions  InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorProductId, variantId, salonId, branchId])
  @@index([salonId])
  @@index([branchId])
  @@index([vendorProductId])
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  stockId       String
  type          InventoryTransactionType
  quantity      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime                 @default(now())

  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([type])
}

model FeedPost {
  id          String         @id @default(uuid())
  vendorId    String
  staffId     String?
  salonId     String
  branchId    String?
  caption     String?
  visibility  FeedVisibility @default(PUBLIC)
  status      FeedPostStatus @default(PUBLISHED)
  publishedAt DateTime?
  deletedAt   DateTime?
  deletedBy   String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  vendor   User           @relation("FeedPostVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  staff    SalonStaff?    @relation("FeedPostStaff", fields: [staffId], references: [id], onDelete: SetNull)
  salon    Salon          @relation("FeedPostSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch   Salon?         @relation("FeedPostBranch", fields: [branchId], references: [id], onDelete: SetNull)
  media    FeedMedia[]
  likes    FeedPostLike[]
  comments FeedComment[]
  views    FeedPostView[]
  shares   FeedShare[]
  reports  FeedReport[]

  @@index([vendorId])
  @@index([staffId])
  @@index([salonId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@index([vendorId, status, createdAt])
  @@index([salonId, branchId, staffId, createdAt])
}

model FeedStory {
  id          String          @id @default(uuid())
  vendorId    String
  staffId     String?
  salonId     String
  branchId    String?
  caption     String?
  status      FeedStoryStatus @default(PUBLISHED)
  publishedAt DateTime
  expiresAt   DateTime
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  vendor  User            @relation("FeedStoryVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  staff   SalonStaff?     @relation("FeedStoryStaff", fields: [staffId], references: [id], onDelete: SetNull)
  salon   Salon           @relation("FeedStorySalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch  Salon?          @relation("FeedStoryBranch", fields: [branchId], references: [id], onDelete: SetNull)
  media   FeedMedia[]
  views   FeedStoryView[]
  reports FeedReport[]

  @@index([vendorId])
  @@index([staffId])
  @@index([salonId])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([vendorId, status, createdAt])
  @@index([salonId, branchId, staffId, createdAt])
}

model FeedMedia {
  id              String        @id @default(uuid())
  postId          String?
  storyId         String?
  type            FeedMediaType
  url             String
  thumbnailUrl    String?
  fileName        String?
  mimeType        String?
  width           Int?
  height          Int?
  durationSeconds Int?
  fileSize        Int?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  post  FeedPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  story FeedStory? @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([storyId])
}

model FeedPostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedPostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model FeedComment {
  id        String            @id @default(uuid())
  postId    String
  userId    String
  parentId  String?
  message   String
  status    FeedCommentStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  post    FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation("FeedCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  parent  FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies FeedComment[] @relation("FeedCommentReplies")

  @@index([postId])
  @@index([userId])
}

model FeedPostView {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedPostViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model FeedStoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story FeedStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User      @relation("FeedStoryViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model FeedShare {
  id        String            @id @default(uuid())
  postId    String
  userId    String
  channel   FeedSharePlatform @default(COPY_LINK)
  createdAt DateTime          @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedShareUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model FeedReport {
  id             String           @id @default(uuid())
  postId         String?
  storyId        String?
  reporterUserId String
  reason         FeedReportReason
  details        String?
  status         FeedReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  post       FeedPost?  @relation(fields: [postId], references: [id], onDelete: SetNull)
  story      FeedStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  reporter   User       @relation("FeedReportUser", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy User?      @relation("FeedReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([storyId])
  @@index([status])
}

model FeedAdminAudit {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  salonId    String?
  branchId   String?
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([salonId, branchId])
}

model SubscriptionFeature {
  id           String                          @id @default(uuid())
  key          String                          @unique
  displayName  String
  description  String?
  featureText  String?
  sortOrder    Int                             @default(0)
  isActive     Boolean                         @default(true)
  createdById  String?
  createdBy    User?                           @relation("SubscriptionFeatureCreator", fields: [createdById], references: [id], onDelete: SetNull)
  planFeatures SubscriptionPlanFeature[]
  permissions  SubscriptionFeaturePermission[]
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
}

model SubscriptionFeaturePermission {
  id           String              @id @default(uuid())
  featureId    String
  permissionId String
  feature      SubscriptionFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  permission   Permission          @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([featureId, permissionId])
  @@index([permissionId])
}

model SubscriptionPlanPermission {
  id           String                     @id @default(uuid())
  planId       String
  permissionId String
  userType     SubscriptionAccessUserType @default(VENDOR)
  plan         SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  permission   Permission                 @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionId, userType])
  @@index([permissionId])
}

model SubscriptionPlanRolePermission {
  id           String           @id @default(uuid())
  planId       String
  roleId       String?
  staffRoleId  String?
  permissionId String
  accessKey    String           @unique
  enabled      Boolean          @default(true)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  role         Role?            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  staffRole    StaffRole?       @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([planId, roleId])
  @@index([planId, staffRoleId])
  @@index([permissionId])
}

model SubscriptionPlanMenu {
  id        String                     @id @default(uuid())
  planId    String
  menuId    String
  userType  SubscriptionAccessUserType @default(VENDOR)
  enabled   Boolean                    @default(false)
  plan      SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  menu      Menu                       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@unique([planId, menuId, userType])
  @@index([menuId, enabled])
}

model SubscriptionPlan {
  id                  String                           @id @default(uuid())
  name                String
  slug                String                           @unique
  description         String?
  shortDescription    String?
  monthlyPrice        Int                              @default(0)
  annualPrice         Int                              @default(0)
  currency            String                           @default("INR")
  monthlyEnabled      Boolean                          @default(true)
  annualEnabled       Boolean                          @default(true)
  isActive            Boolean                          @default(true)
  displayOrder        Int                              @default(0)
  badge               String?
  highlight           Boolean                          @default(false)
  trialDays           Int                              @default(0)
  maxBranches         Int?
  maxStaff            Int?
  maxCustomers        Int?
  maxBookings         Int?
  maxStorage          Int?
  maxBookingsPerMonth Int?
  featureTitle        String?
  featureDescription  String?
  ctaText             String?
  badgeText           String?
  monthlyDescription  String?
  annualDescription   String?
  promotionalText     String?
  termsText           String?
  renewalText         String?
  features            SubscriptionPlanFeature[]
  subscriptions       Subscription[]
  payments            SubscriptionPayment[]
  roles               Role[]
  permissions         SubscriptionPlanPermission[]
  rolePermissions     SubscriptionPlanRolePermission[]
  menuEntitlements    SubscriptionPlanMenu[]
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@index([isActive, displayOrder])
}

model SubscriptionPlanFeature {
  id        String              @id @default(uuid())
  planId    String
  featureId String
  enabled   Boolean             @default(false)
  limits    Json?
  sortOrder Int                 @default(0)
  plan      SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   SubscriptionFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId, enabled])
}

model Subscription {
  id                     String                 @id @default(uuid())
  vendorId               String
  salonId                String?
  planId                 String
  billingCycle           BillingCycle
  status                 SubscriptionStatus     @default(ACTIVE)
  amount                 Int                    @default(0)
  currency               String                 @default("INR")
  startsAt               DateTime               @default(now())
  renewsAt               DateTime?
  expiresAt              DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  razorpaySubscriptionId String?                @unique
  isManual               Boolean                @default(false)
  notes                  String?
  vendor                 User                   @relation("SubscriptionVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  salon                  Salon?                 @relation("SubscriptionSalon", fields: [salonId], references: [id], onDelete: SetNull)
  plan                   SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments               SubscriptionPayment[]
  invoices               SubscriptionInvoice[]
  auditLogs              SubscriptionAuditLog[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([vendorId, status])
  @@index([planId, status])
  @@index([expiresAt])
}

model SubscriptionPayment {
  id                String                    @id @default(uuid())
  subscriptionId    String
  vendorId          String
  planId            String
  amount            Int
  currency          String                    @default("INR")
  status            SubscriptionPaymentStatus @default(CREATED)
  razorpayOrderId   String?                   @unique
  razorpayPaymentId String?                   @unique
  razorpaySignature String?
  providerReference String?
  paidAt            DateTime?
  failureReason     String?
  subscription      Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  vendor            User                      @relation("SubscriptionPaymentVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoice           SubscriptionInvoice?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([vendorId, status])
  @@index([subscriptionId])
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid())
  invoiceNumber  String                    @unique
  subscriptionId String
  paymentId      String?                   @unique
  vendorId       String
  amount         Int
  currency       String                    @default("INR")
  status         SubscriptionInvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  paidAt         DateTime?
  dueAt          DateTime?
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment        SubscriptionPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  vendor         User                      @relation("SubscriptionInvoiceVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([vendorId, status])
}

model SubscriptionWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

model SubscriptionAuditLog {
  id             String        @id @default(uuid())
  actorId        String?
  vendorId       String?
  subscriptionId String?
  action         String
  targetType     String
  targetId       String
  details        Json?
  actor          User?         @relation("SubscriptionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  vendor         User?         @relation("SubscriptionAuditVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([vendorId, createdAt])
  @@index([targetType, targetId])
}

model RazorpayConfiguration {
  id                     String              @id @default(uuid())
  provider               String              @default("RAZORPAY")
  scope                  RazorpayScope       @default(PLATFORM)
  ownerId                String?
  environment            RazorpayEnvironment @default(TEST)
  keyId                  String
  encryptedKeySecret     String
  encryptedWebhookSecret String?
  enabled                Boolean             @default(false)
  createdBy              String
  updatedBy              String?
  creator                User                @relation("RazorpayConfigCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  owner                  User?               @relation("RazorpayConfigOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([environment, enabled])
  @@index([scope, ownerId, environment])
}

model SalonContact {
  id      String @id @default(uuid())
  salonId String

  phone       String
  countryCode String

  email String?

  isPrimary  Boolean @default(false)
  isWhatsapp Boolean @default(false)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Address {
  id      String @id @default(uuid())
  salonId String @unique

  line1   String
  line2   String?
  city    String
  state   String
  pincode String
  country String

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonImage {
  id      String @id @default(uuid())
  salonId String
  url     String

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonStaff {
  id      String @id @default(uuid())
  userId  String
  salonId String

  role        String? // e.g. barber, manager
  staffRoleId String?

  isActive Boolean @default(true)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffRole StaffRole? @relation(fields: [staffRoleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("StaffCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("StaffUpdatedBy", fields: [updatedById], references: [id])

  attendances                Attendance[]
  bookings                   Booking[]
  feedPosts                  FeedPost[]                    @relation("FeedPostStaff")
  feedStories                FeedStory[]                   @relation("FeedStoryStaff")
  reviews                    Review[]
  bankDetails                StaffBankDetails?
  bookingFinanceTransactions BookingFinancialTransaction[] @relation("BookingFinanceStaff")

  @@unique([userId, salonId])
  @@index([salonId, isActive, createdAt])
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum StaffBankAccountType {
  SAVINGS
  CURRENT
  SALARY
  OTHER
}

model StaffBankDetails {
  id                     String               @id @default(uuid())
  staffId                String               @unique
  accountHolderName      String
  bankName               String
  encryptedAccountNumber String
  ifscCode               String
  bankCode               String
  accountType            StaffBankAccountType
  branchName             String?
  upiId                  String?
  upiName                String?
  upiUri                 String?
  qrCode                 String?
  isVerified             Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  staff SalonStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String           @id @default(uuid())
  staffId    String
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String

  staff    SalonStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  markedBy User       @relation(fields: [markedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
}

model ServiceCategory {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  services Service[]
}

model Service {
  id          String  @id @default(uuid())
  salonId     String // The salon that owns this service
  name        String
  description String?

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  basePrice    Float
  baseDuration Int // in minutes

  isActive Boolean @default(true)

  // Audit
  createdById String?
  updatedById String?
  createdBy   User?   @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?   @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])

  // Relations
  salon             Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  images            ServiceImage[]
  comboItems        ComboItem[]
  bookingItems      BookingService[]
  coupons           Coupon[]
  couponAssignments CouponService[]
  advertisements    Advertisement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
}

model ServiceImage {
  id        String @id @default(uuid())
  serviceId String
  url       String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Combo {
  id      String @id @default(uuid())
  salonId String // The combo is specific to a salon/branch

  name        String
  description String?
  price       Float // Total combo price
  duration    Int // Total duration
  imageUrl    String?

  isActive Boolean @default(true)

  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  items        ComboItem[]
  bookingItems BookingService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComboItem {
  id        String @id @default(uuid())
  comboId   String
  serviceId String

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([comboId, serviceId])
}

model SalonCustomer {
  id      String @id @default(uuid())
  salonId String
  userId  String

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, userId])
}

// RBAC Schemas
model Permission {
  id          String  @id @default(uuid())
  action      String  @unique // e.g., "salons.view"
  description String?

  menuPermissions       MenuPermission[]
  routePermissions      RoutePermission[]
  staffRolePermissions  StaffRolePermission[]
  rolePermissions       RolePermission[]
  userPermissions       UserPermission[]
  subscriptionFeatures  SubscriptionFeaturePermission[]
  subscriptionPlans     SubscriptionPlanPermission[]
  subscriptionPlanRoles SubscriptionPlanRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isAllowed    Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId])
  @@index([permissionId])
}

model Menu {
  id            String  @id @default(uuid())
  label         String
  icon          String?
  path          String?
  parentId      String?
  parent        Menu?   @relation("MenuHierarchy", fields: [parentId], references: [id])
  children      Menu[]  @relation("MenuHierarchy")
  order         Int     @default(0)
  showInSidebar Boolean @default(true)
  audience      String  @default("ALL")

  menuPermissions       MenuPermission[]
  subscriptionPlanMenus SubscriptionPlanMenu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuPermission {
  id           String @id @default(uuid())
  menuId       String
  permissionId String

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([menuId, permissionId])
}

model Route {
  id          String  @id @default(uuid())
  path        String // e.g., "/salons/:id"
  method      String // e.g., "GET", "POST", "ALL"
  description String?

  routePermissions RoutePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([path, method])
}

model RoutePermission {
  id           String @id @default(uuid())
  routeId      String
  permissionId String

  route      Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([routeId, permissionId])
}

model StaffRole {
  id          String  @id @default(uuid())
  salonId     String? // Null for global/default roles
  name        String
  description String?

  salon                       Salon?                           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff                       SalonStaff[]
  permissions                 StaffRolePermission[]
  subscriptionPlanPermissions SubscriptionPlanRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, name])
}

model StaffRolePermission {
  id           String @id @default(uuid())
  staffRoleId  String
  permissionId String

  staffRole  StaffRole  @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([staffRoleId, permissionId])
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  countryCode String     @default("+1")
  message     String?
  status      LeadStatus @default(NEW)
  metadata    Json? // For IP, campaign, referrer, etc.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// GST Configuration model
model GSTConfiguration {
  id       String  @id @default(uuid())
  salonId  String
  cgstRate Float   @default(9.0) // Central GST rate in percentage
  sgstRate Float   @default(9.0) // State GST rate in percentage
  igstRate Float   @default(18.0) // Integrated GST rate in percentage
  isActive Boolean @default(true)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId])
}

model Booking {
  id                 String  @id @default(uuid())
  salonId            String
  branchId           String?
  customerId         String // References User.id
  staffId            String? // References SalonStaff.id
  gstConfigurationId String?

  bookingDate   DateTime // The scheduled date/time
  status        BookingStatus  @default(PENDING)
  medium        BookingMedium  @default(IN_SALON)
  bookingSource BookingSource?

  // Amount fields
  totalAmount    Float // Sum of services/combos (before tax)
  discount       Float @default(0)
  discountAmount Float @default(0) // Discount amount in rupees
  taxableAmount  Float @default(0) // Amount on which tax is calculated

  // GST fields
  cgstAmount     Float @default(0) // Central GST amount
  sgstAmount     Float @default(0) // State GST amount
  igstAmount     Float @default(0) // Integrated GST amount
  totalTaxAmount Float @default(0) // Total tax (CGST + SGST/IGST)

  finalAmount Float // totalAmount - discount + total tax
  totalPaid   Float @default(0) // Tracks total of completed payments

  notes    String?
  couponId String?

  salon     Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch    Salon?            @relation("BookingBranch", fields: [branchId], references: [id], onDelete: SetNull)
  customer  User              @relation("CustomerBookings", fields: [customerId], references: [id])
  staff     SalonStaff?       @relation(fields: [staffId], references: [id])
  gstConfig GSTConfiguration? @relation(fields: [gstConfigurationId], references: [id], onDelete: SetNull)
  coupon    Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)

  services             BookingService[]
  payments             Payment[]
  reviews              Review[]
  couponRedemptions    CouponRedemption[]
  financialTransaction BookingFinancialTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([branchId])
  @@index([salonId, branchId, bookingDate, status])
  @@index([bookingDate])
  @@index([status, bookingDate])
  @@index([bookingSource])
  @@index([staffId, bookingDate, status])
  @@index([customerId])
  @@index([gstConfigurationId])
  @@index([couponId])
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String             @unique
  title              String
  description        String?
  ownerType          CouponOwnerType
  ownerId            String
  salonId            String?
  branchId           String?
  serviceId          String?
  discountType       CouponDiscountType
  discountValue      Float
  minimumOrderAmount Float              @default(0)
  maximumDiscount    Float?
  usageLimit         Int?
  usagePerCustomer   Int?
  startAt            DateTime
  endAt              DateTime
  isActive           Boolean            @default(false)
  owner              User               @relation("CouponOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  salon              Salon?             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch             Salon?             @relation("CouponBranch", fields: [branchId], references: [id], onDelete: Cascade)
  service            Service?           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  redemptions        CouponRedemption[]
  vendorAssignments  CouponVendor[]
  salonAssignments   CouponSalon[]
  branchAssignments  CouponBranch[]
  serviceAssignments CouponService[]
  bookings           Booking[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([ownerId, isActive])
  @@index([salonId, branchId, serviceId])
  @@index([startAt, endAt])
}

model CouponVendor {
  couponId String
  vendorId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([couponId, vendorId])
  @@index([vendorId])
}

model CouponSalon {
  couponId String
  salonId  String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  salon    Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@id([couponId, salonId])
  @@index([salonId])
}

model CouponBranch {
  couponId String
  branchId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  branch   Salon  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([couponId, branchId])
  @@index([branchId])
}

model CouponService {
  couponId  String
  serviceId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([couponId, serviceId])
  @@index([serviceId])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  customerId String
  bookingId  String?
  amount     Float
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([customerId, couponId])
  @@index([bookingId])
}

model Review {
  id         String       @id @default(uuid())
  customerId String
  bookingId  String
  salonId    String
  branchId   String?
  staffId    String?
  rating     Int
  comment    String?
  status     ReviewStatus @default(PUBLISHED)
  customer   User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  salon      Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch     Salon?       @relation("ReviewBranch", fields: [branchId], references: [id], onDelete: SetNull)
  staff      SalonStaff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([customerId, bookingId])
  @@index([salonId, status])
  @@index([staffId, status])
}

model CustomerWallet {
  id           String              @id @default(uuid())
  customerId   String              @unique
  balance      Float               @default(0)
  currency     String              @default("INR")
  customer     User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  customerId    String
  type          WalletTransactionType
  amount        Float
  referenceType String?
  referenceId   String?
  description   String?
  status        WalletTransactionStatus @default(COMPLETED)
  wallet        CustomerWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  customer      User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime                @default(now())

  @@index([customerId, createdAt])
  @@index([referenceType, referenceId])
}

model ReferralConfig {
  id             String    @id @default(uuid())
  rewardAmount   Float     @default(0)
  campaignActive Boolean   @default(false)
  qualification  Json?
  expiresAt      DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

model CustomerReferral {
  id                 String         @id @default(uuid())
  referrerCustomerId String
  referredCustomerId String?
  referralCode       String         @unique
  status             ReferralStatus @default(PENDING)
  rewardAmount       Float          @default(0)
  rewardStatus       RewardStatus   @default(PENDING)
  createdAt          DateTime       @default(now())
  referrer           User           @relation("ReferralSender", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referred           User?          @relation("ReferralReceiver", fields: [referredCustomerId], references: [id], onDelete: SetNull)

  @@index([referrerCustomerId])
  @@index([referredCustomerId])
}

model Advertisement {
  id               String                      @id @default(uuid())
  title            String
  description      String?
  image            String?
  media            String?
  targetType       String?
  targetId         String?
  salonId          String?
  branchId         String?
  serviceId        String?
  ctaText          String?
  startAt          DateTime?
  endAt            DateTime?
  priority         Int                         @default(0)
  status           AdvertisementStatus         @default(DRAFT)
  createdById      String
  updatedById      String?
  deletedAt        DateTime?
  mediaType        AdvertisementMediaType      @default(TEXT)
  mediaUrl         String?
  thumbnailUrl     String?
  actionEnabled    Boolean                     @default(false)
  actionButtonName String?
  actionType       AdvertisementActionType     @default(NONE)
  actionUrl        String?
  targetAudience   AdvertisementTargetAudience @default(BOTH)
  targetingMode    AdvertisementTargetingMode  @default(ALL)
  durationValue    Int?
  durationUnit     AdvertisementDurationUnit?
  displayOrder     Int                         @default(0)
  pincodes         AdvertisementPincode[]
  salon            Salon?                      @relation(fields: [salonId], references: [id], onDelete: SetNull)
  branch           Salon?                      @relation("AdvertisementBranch", fields: [branchId], references: [id], onDelete: SetNull)
  service          Service?                    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy        User                        @relation("AdvertisementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy        User?                       @relation("AdvertisementUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status, startAt, endAt])
  @@index([salonId, branchId, serviceId])
  @@index([targetAudience, status, startAt, endAt, deletedAt])
}

model AdvertisementPincode {
  id              String        @id @default(uuid())
  advertisementId String
  pincode         String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([advertisementId, pincode])
  @@index([pincode, advertisementId])
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId, isDefault])
}

model CustomerFavoriteSalon {
  id         String   @id @default(uuid())
  customerId String
  salonId    String
  createdAt  DateTime @default(now())

  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salon    Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([customerId, salonId])
  @@index([customerId])
  @@index([salonId])
}

model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String?
  comboId   String?

  name     String // Snapshot of service/combo name
  price    Float // Snapshot of price at booking time
  quantity Int    @default(1)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  combo   Combo?   @relation(fields: [comboId], references: [id])

  @@index([bookingId])
  @@index([serviceId, bookingId])
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String
  vendorId  String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendor   User?     @relation("ExpenseCategoryVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
}

model Expense {
  id              String               @id @default(uuid())
  salonId         String
  branchId        String?
  categoryId      String
  expenseDate     DateTime             @db.Date
  amount          Decimal              @db.Decimal(12, 2)
  paymentMethod   ExpensePaymentMethod
  note            String?
  description     String?
  referenceNumber String?
  receiptUrl      String?
  status          ExpenseStatus        @default(ACTIVE)
  createdBy       String
  updatedBy       String?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  salon    Salon           @relation("ExpenseSalon", fields: [salonId], references: [id], onDelete: Restrict)
  branch   Salon?          @relation("ExpenseBranch", fields: [branchId], references: [id], onDelete: SetNull)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator  User            @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?           @relation("ExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([salonId, branchId, expenseDate])
  @@index([categoryId, expenseDate])
  @@index([status, deletedAt])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String? // For UPI/Card references
  completedAt   DateTime?
  failureReason String?

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([method, status, createdAt])
  @@index([transactionId])
  @@index([bookingId, status])
}

model PaymentRefund {
  id              String       @id @default(uuid())
  paymentId       String
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR")
  reason          String
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @unique
  idempotencyKey  String       @unique
  failureReason   String?
  createdById     String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model BookingCommissionRule {
  id              String                        @id @default(uuid())
  commissionType  BookingCommissionType
  commissionValue Decimal                       @db.Decimal(12, 2)
  currency        String                        @default("INR")
  applicableTo    String                        @default("BOOKINGS")
  isActive        Boolean                       @default(true)
  effectiveFrom   DateTime                      @default(now())
  effectiveTo     DateTime?
  createdById     String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  createdBy       User?                         @relation("BookingCommissionRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions    BookingFinancialTransaction[]

  @@index([isActive, effectiveFrom, effectiveTo])
}

model BookingFinancialTransaction {
  id                   String                       @id @default(uuid())
  bookingId            String                       @unique
  customerId           String
  vendorId             String
  salonId              String
  branchId             String?
  staffId              String?
  commissionRuleId     String?
  bookingAmount        Decimal                      @db.Decimal(12, 2)
  vendorGrossAmount    Decimal                      @db.Decimal(12, 2)
  commissionType       BookingCommissionType
  commissionValue      Decimal                      @db.Decimal(12, 2)
  commissionAmount     Decimal                      @db.Decimal(12, 2)
  vendorPayableAmount  Decimal                      @db.Decimal(12, 2)
  currency             String                       @default("INR")
  paymentStatus        PaymentStatus                @default(COMPLETED)
  approvalStatus       BookingFinanceApprovalStatus @default(PENDING)
  settlementStatus     BookingSettlementStatus      @default(NOT_READY)
  approvedById         String?
  approvedAt           DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  decisionReason       String?
  settledAt            DateTime?
  manualReviewRequired Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  booking        Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer       User                   @relation("BookingFinanceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  vendor         User                   @relation("BookingFinanceVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  salon          Salon                  @relation("BookingFinanceSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch         Salon?                 @relation("BookingFinanceBranch", fields: [branchId], references: [id], onDelete: SetNull)
  staff          SalonStaff?            @relation("BookingFinanceStaff", fields: [staffId], references: [id], onDelete: SetNull)
  commissionRule BookingCommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  approvedBy     User?                  @relation("BookingFinanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy     User?                  @relation("BookingFinanceRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  walletEntries  VendorWalletLedger[]
  settlements    VendorSettlement[]

  @@index([vendorId, createdAt])
  @@index([salonId, branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([approvalStatus, settlementStatus, createdAt])
  @@index([paymentStatus, createdAt])
}

model VendorWallet {
  id                String               @id @default(uuid())
  vendorId          String               @unique
  currency          String               @default("INR")
  pendingBalance    Decimal              @default(0) @db.Decimal(14, 2)
  availableBalance  Decimal              @default(0) @db.Decimal(14, 2)
  processingBalance Decimal              @default(0) @db.Decimal(14, 2)
  paidBalance       Decimal              @default(0) @db.Decimal(14, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  vendor            User                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entries           VendorWalletLedger[]

  @@index([updatedAt])
}

model VendorWalletLedger {
  id                String                       @id @default(uuid())
  walletId          String
  bookingFinanceId  String?
  settlementId      String?
  type              VendorWalletEntryType
  bucket            VendorWalletBucket
  amount            Decimal                      @db.Decimal(14, 2)
  balanceBefore     Decimal                      @db.Decimal(14, 2)
  balanceAfter      Decimal                      @db.Decimal(14, 2)
  idempotencyKey    String                       @unique
  reference         String?
  paymentReference  String?
  razorpayReference String?
  description       String
  metadata          Json?
  createdById       String?
  processedAt       DateTime?
  createdAt         DateTime                     @default(now())
  wallet            VendorWallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bookingFinance    BookingFinancialTransaction? @relation(fields: [bookingFinanceId], references: [id], onDelete: SetNull)
  settlement        VendorSettlement?            @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdBy         User?                        @relation("VendorWalletLedgerActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([bookingFinanceId, createdAt])
  @@index([settlementId, createdAt])
}

model VendorPayoutAccount {
  id                     String   @id @default(uuid())
  vendorId               String   @unique
  accountHolderName      String
  bankName               String
  encryptedAccountNumber String
  ifscCode               String
  accountType            String   @default("CURRENT")
  razorpayContactId      String?
  razorpayFundAccountId  String?
  isVerified             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  vendor                 User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([razorpayFundAccountId])
}

model BookingSettlementSettings {
  id                          String                        @id @default("global")
  settlementMode              BookingSettlementMode         @default(MANUAL)
  intervalValue               Int                           @default(1)
  intervalUnit                BookingSettlementIntervalUnit @default(DAYS)
  minimumSettlementAmount     Decimal                       @default(0) @db.Decimal(14, 2)
  autoSettlementEnabled       Boolean                       @default(false)
  nextSettlementAt            DateTime?
  encryptedDebitAccountNumber String?
  payoutMode                  String                        @default("IMPS")
  updatedById                 String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  updatedBy                   User?                         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model VendorSettlement {
  id                  String                        @id @default(uuid())
  vendorId            String
  amount              Decimal                       @db.Decimal(14, 2)
  currency            String                        @default("INR")
  status              VendorSettlementStatus        @default(PROCESSING)
  idempotencyKey      String                        @unique
  referenceId         String                        @unique
  razorpayPayoutId    String?                       @unique
  utr                 String?
  failureReason       String?
  initiatedById       String?
  processedAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  vendor              User                          @relation("VendorSettlementVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  initiatedBy         User?                         @relation("VendorSettlementCreator", fields: [initiatedById], references: [id], onDelete: SetNull)
  walletEntries       VendorWalletLedger[]
  bookingTransactions BookingFinancialTransaction[]

  @@index([vendorId, status, createdAt])
  @@index([status, createdAt])
}

model BookingFinanceAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  targetType String
  targetId   String
  action     String
  fromStatus String?
  toStatus   String?
  reason     String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

model RazorpayPayoutWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  payoutId    String?
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([payoutId, createdAt])
  @@index([processed, createdAt])
}

model WhatsAppConfiguration {
  id                     String               @id @default(uuid())
  provider               String               @default("meta")
  metaAppId              String
  encryptedMetaAppSecret String
  encryptedAccessToken   String
  businessAccountId      String
  apiVersion             String
  webhookVerifyToken     String
  encryptedWebhookSecret String
  publicWebhookUrl       String
  environment            WhatsAppEnvironment  @default(PRODUCTION)
  status                 WhatsAppConfigStatus @default(INACTIVE)
  createdBy              String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  creator                User                 @relation("WhatsAppConfigCreatedBy", fields: [createdBy], references: [id])

  @@index([status])
}

model WhatsAppConnection {
  id                   String                   @id @default(uuid())
  vendorId             String
  salonId              String
  branchId             String?
  provider             String                   @default("meta")
  businessAccountId    String
  phoneNumberId        String
  displayPhoneNumber   String?
  verifiedName         String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  apiVersion           String
  status               WhatsAppConnectionStatus @default(PENDING)
  qualityRating        String?
  messagingLimit       String?
  lastHealthCheckAt    DateTime?
  lastConnectedAt      DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  salon                Salon                    @relation("WhatsAppConnectionSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch               Salon?                   @relation("WhatsAppConnectionBranch", fields: [branchId], references: [id], onDelete: SetNull)
  contacts             WhatsAppContact[]
  campaigns            WhatsAppCampaign[]
  messages             WhatsAppMessage[]

  @@index([vendorId])
  @@index([salonId])
  @@index([branchId])
  @@index([phoneNumberId])
  @@index([status])
}

model WhatsAppContact {
  id                    String                      @id @default(uuid())
  vendorId              String
  salonId               String
  branchId              String?
  customerId            String?
  name                  String
  phoneNumber           String
  normalizedPhoneNumber String
  countryCode           String
  optInStatus           WhatsAppOptInStatus         @default(UNKNOWN)
  consentSource         WhatsAppConsentSource?
  optInAt               DateTime?
  optOutAt              DateTime?
  tags                  Json?
  metadata              Json?
  status                String                      @default("ACTIVE")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  salon                 Salon                       @relation("WhatsAppContactSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch                Salon?                      @relation("WhatsAppContactBranch", fields: [branchId], references: [id], onDelete: SetNull)
  customer              User?                       @relation("WhatsAppContactCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  messages              WhatsAppMessage[]
  recipients            WhatsAppCampaignRecipient[]
  whatsAppConnection    WhatsAppConnection?         @relation(fields: [whatsAppConnectionId], references: [id])
  whatsAppConnectionId  String?

  @@unique([salonId, normalizedPhoneNumber])
  @@index([vendorId])
  @@index([salonId])
  @@index([branchId])
  @@index([normalizedPhoneNumber])
  @@index([optInStatus])
}

model WhatsAppTemplate {
  id                 String                   @id @default(uuid())
  vendorId           String?
  salonId            String?
  branchId           String?
  providerTemplateId String?
  name               String
  language           String
  category           WhatsAppTemplateCategory
  body               String
  headerType         String?
  headerText         String?
  footerText         String?
  buttons            Json?
  variables          Json?
  status             WhatsAppTemplateStatus   @default(DRAFT)
  providerStatus     String?
  rejectionReason    String?
  createdBy          String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  salon              Salon?                   @relation("WhatsAppTemplateSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch             Salon?                   @relation("WhatsAppTemplateBranch", fields: [branchId], references: [id], onDelete: SetNull)
  creator            User                     @relation("WhatsAppTemplateCreatedBy", fields: [createdBy], references: [id])
  campaigns          WhatsAppCampaign[]
  messages           WhatsAppMessage[]

  @@index([vendorId])
  @@index([salonId])
  @@index([branchId])
  @@index([status])
}

model WhatsAppCampaign {
  id                   String                      @id @default(uuid())
  vendorId             String
  salonId              String
  branchId             String?
  name                 String
  description          String?
  templateId           String
  connectionId         String
  campaignType         WhatsAppCampaignType
  audienceType         WhatsAppAudienceType
  scheduledAt          DateTime?
  timezone             String?
  status               WhatsAppCampaignStatus      @default(DRAFT)
  archivedAt           DateTime?
  totalRecipients      Int                         @default(0)
  queuedCount          Int                         @default(0)
  sentCount            Int                         @default(0)
  deliveredCount       Int                         @default(0)
  readCount            Int                         @default(0)
  repliedCount         Int                         @default(0)
  failedCount          Int                         @default(0)
  estimatedCost        Float                       @default(0)
  actualCost           Float                       @default(0)
  providerCostEstimate Float                       @default(0)
  estimatedAdminMargin Float                       @default(0)
  providerCostTotal    Float                       @default(0)
  adminMarginTotal     Float                       @default(0)
  pricingSnapshot      Json?
  templatePayload      Json?
  currency             String                      @default("INR")
  startedAt            DateTime?
  completedAt          DateTime?
  createdBy            String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  salon                Salon                       @relation("WhatsAppCampaignSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch               Salon?                      @relation("WhatsAppCampaignBranch", fields: [branchId], references: [id], onDelete: SetNull)
  template             WhatsAppTemplate            @relation(fields: [templateId], references: [id])
  connection           WhatsAppConnection          @relation(fields: [connectionId], references: [id])
  creator              User                        @relation("WhatsAppCampaignCreatedBy", fields: [createdBy], references: [id])
  recipients           WhatsAppCampaignRecipient[]
  messages             WhatsAppMessage[]
  usage                WhatsAppUsageLedger[]
  billing              WhatsAppCampaignBilling?

  @@index([vendorId, status])
  @@index([salonId, branchId])
  @@index([templateId])
  @@index([connectionId])
  @@index([scheduledAt])
  @@index([createdAt])
}

model WhatsAppCampaignRecipient {
  id                  String                  @id @default(uuid())
  campaignId          String
  contactId           String
  customerId          String?
  phoneNumberSnapshot String
  nameSnapshot        String
  status              WhatsAppRecipientStatus @default(QUEUED)
  providerMessageId   String?
  failureCode         String?
  failureReason       String?
  unitCost            Float                   @default(0)
  currency            String                  @default("INR")
  queuedAt            DateTime                @default(now())
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  respondedAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  campaign            WhatsAppCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact             WhatsAppContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([providerMessageId])
}

model WhatsAppPricing {
  id                     String                   @id @default(uuid())
  provider               String                   @default("meta")
  messageCategory        WhatsAppTemplateCategory
  costPerMessage         Float
  providerCostPerMessage Float                    @default(0)
  vendorPricePerMessage  Float                    @default(0)
  campaignCharge         Float                    @default(0)
  notes                  String?
  currency               String                   @default("INR")
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  active                 Boolean                  @default(true)
  createdBy              String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([provider, messageCategory, active])
  @@index([effectiveFrom, effectiveTo])
}

model WhatsAppMessage {
  id                   String                   @id @default(uuid())
  vendorId             String
  salonId              String
  branchId             String?
  campaignId           String?
  contactId            String?
  customerId           String?
  connectionId         String
  templateId           String?
  direction            WhatsAppDirection
  messageType          WhatsAppMessageType
  providerMessageId    String?
  phoneNumber          String
  messageBody          String?
  templatePayload      Json?
  status               WhatsAppMessageStatus    @default(QUEUED)
  failureCode          String?
  failureReason        String?
  pricingId            String?
  messageCategory      WhatsAppTemplateCategory
  unitCost             Float                    @default(0)
  providerCostSnapshot Float                    @default(0)
  vendorPriceSnapshot  Float                    @default(0)
  vendorCharge         Float                    @default(0)
  providerCost         Float                    @default(0)
  adminMargin          Float                    @default(0)
  currency             String                   @default("INR")
  queuedAt             DateTime                 @default(now())
  submittedAt          DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  salon                Salon                    @relation("WhatsAppMessageSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch               Salon?                   @relation("WhatsAppMessageBranch", fields: [branchId], references: [id], onDelete: SetNull)
  campaign             WhatsAppCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact              WhatsAppContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  connection           WhatsAppConnection       @relation(fields: [connectionId], references: [id])
  template             WhatsAppTemplate?        @relation(fields: [templateId], references: [id])
  usage                WhatsAppUsageLedger[]

  @@unique([campaignId, contactId])
  @@index([vendorId, status])
  @@index([salonId])
  @@index([branchId])
  @@index([campaignId])
  @@index([templateId])
  @@index([contactId])
  @@index([connectionId])
  @@index([providerMessageId])
  @@index([createdAt])
}

model WhatsAppUsageLedger {
  id              String                   @id @default(uuid())
  vendorId        String
  salonId         String
  branchId        String?
  campaignId      String?
  messageId       String?
  messageCategory WhatsAppTemplateCategory
  unitCost        Float
  quantity        Int                      @default(1)
  totalCost       Float
  currency        String                   @default("INR")
  status          WhatsAppLedgerStatus     @default(PENDING)
  idempotencyKey  String?                  @unique
  createdAt       DateTime                 @default(now())
  salon           Salon                    @relation("WhatsAppUsageSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch          Salon?                   @relation("WhatsAppUsageBranch", fields: [branchId], references: [id], onDelete: SetNull)
  campaign        WhatsAppCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message         WhatsAppMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([salonId, branchId])
  @@index([messageCategory, status])
}

model WhatsAppCampaignBilling {
  id                   String                @id @default(uuid())
  campaignId           String                @unique
  vendorId             String
  salonId              String
  branchId             String?
  messageCount         Int                   @default(0)
  billableMessageCount Int                   @default(0)
  perMessageRate       Float                 @default(0)
  campaignCharge       Float                 @default(0)
  totalCharge          Float                 @default(0)
  providerCostTotal    Float                 @default(0)
  adminMarginTotal     Float                 @default(0)
  currency             String                @default("INR")
  pricingSnapshot      Json
  billingStatus        WhatsAppBillingStatus @default(CALCULATED)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  campaign             WhatsAppCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  vendor               User                  @relation("WhatsAppBillingVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  salon                Salon                 @relation("WhatsAppBillingSalon", fields: [salonId], references: [id], onDelete: Cascade)
  branch               Salon?                @relation("WhatsAppBillingBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([salonId, branchId, createdAt])
  @@index([billingStatus, createdAt])
}

model WhatsAppIdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  vendorId     String?
  userId       String
  requestHash  String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([key, userId])
  @@index([expiresAt])
}

model WhatsAppWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  provider    String
  eventType   String
  payload     Json
  signature   String?
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
  @@index([processed, createdAt])
}

model WhatsAppAuditLog {
  id         String   @id @default(uuid())
  userId     String?
  role       String?
  vendorId   String?
  salonId    String?
  branchId   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([entityType, entityId])
}

model WhatsAppAutomationSettings {
  id                  String   @id @default(uuid())
  vendorId            String
  salonId             String
  branchId            String?
  bookingConfirmation Boolean  @default(false)
  bookingReminder     Boolean  @default(false)
  bookingCancellation Boolean  @default(false)
  paymentConfirmation Boolean  @default(false)
  invoice             Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([salonId, branchId])
  @@index([vendorId])
}
